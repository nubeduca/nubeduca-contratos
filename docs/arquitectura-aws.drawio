nt x="140" y="550"/></Array></mxGeometry></mxCell><mxCell id="c61" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#232F3E;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="337" y="550" as="sourcePoint"/><mxPoint x="440" y="550" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c62" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#232F3E;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="610" y="686" as="sourcePoint"/><mxPoint x="610" y="824" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c63" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#232F3E;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1110" y="824" as="sourcePoint"/><mxPoint x="1110" y="686" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c64" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#232F3E;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1140" y="420" as="sourcePoint"/><mxPoint x="1259" y="420" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c65" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#232F3E;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1259" y="560" as="sourcePoint"/><mxPoint x="1140" y="560" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c66" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#232F3E;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1140" y="652" as="sourcePoint"/><mxPoint x="1285" y="732" as="targetPoint"/><Array as="points"><mxPoint x="1285" y="652"/></Array></mxGeometry></mxCell><mxCell id="c67" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#232F3E;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1311" y="760" as="sourcePoint"/><mxPoint x="1464" y="760" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c68" value="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="145" y="241" width="22" height="22" as="geometry"/></mxCell><mxCell id="c69" value="2" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="145" y="381" width="22" height="22" as="geometry"/></mxCell><mxCell id="c70" value="3" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="145" y="521" width="22" height="22" as="geometry"/></mxCell><mxCell id="c71" value="4" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="407" y="521" width="22" height="22" as="geometry"/></mxCell><mxCell id="c72" value="5" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="619" y="713" width="22" height="22" as="geometry"/></mxCell><mxCell id="c73" value="6" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1119" y="713" width="22" height="22" as="geometry"/></mxCell><mxCell id="c74" value="7" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1161" y="389" width="22" height="22" as="geometry"/></mxCell><mxCell id="c75" value="8" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1161" y="661" width="22" height="22" as="geometry"/></mxCell><mxCell id="c76" value="9" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1545" y="194" width="22" height="22" as="geometry"/></mxCell><mxCell id="c77" value="Nubeduca · arquitectura de solución orientada a eventos en AWS" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontColor=#232F3E;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="22" width="1300" height="30" as="geometry"/></mxCell><mxCell id="c78" value="LMS multi-tenant (UTEC, UPC, PUCP) · 6 microservicios serverless · 16 eventos de dominio · despliegue con Serverless Framework" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#545B64;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="40" y="57" width="1300" height="21" as="geometry"/></mxCell><mxCell id="c79" value="&lt;b&gt;Cómo fluye una petición&lt;/b&gt;&lt;br&gt;&lt;b&gt;1.&lt;/b&gt; El navegador carga el frontend desde AWS Amplify Hosting.&lt;br&gt;&lt;b&gt;2.&lt;/b&gt; El usuario inicia sesión en Amazon Cognito; el token trae tenant_id y rol.&lt;br&gt;&lt;b&gt;3.&lt;/b&gt; Cada llamada va a la API del microservicio; el authorizer de Cognito valida el token.&lt;br&gt;&lt;b&gt;4.&lt;/b&gt; La Lambda escribe el cambio en su tabla DynamoDB y, en la misma transacción, el evento validado contra su esquema. Los archivos suben directo a S3 con URL prefirmada.&lt;br&gt;&lt;b&gt;5.&lt;/b&gt; DynamoDB Streams y EventBridge Pipes llevan cada evento al bus lms; Archive permite reprocesar. Los esquemas viven en el repo nubeduca-contratos.&lt;br&gt;&lt;b&gt;6.&lt;/b&gt; Una regla por consumidor copia el evento a su cola SQS con DLQ; la Lambda consumidora lo procesa una sola vez (idempotente).&lt;br&gt;&lt;b&gt;7.&lt;/b&gt; Las notas publicadas salen además por SNS FIFO → SQS FIFO, en orden por curso.&lt;br&gt;&lt;b&gt;8.&lt;/b&gt; ms-notificaciones avisa por email con Amazon SNS según las preferencias del usuario.&lt;br&gt;&lt;b&gt;9.&lt;/b&gt; CloudWatch y X-Ray observan todo; Serverless Framework despliega cada microservicio como un stack de CloudFormation." style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontColor=#232F3E;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="1112" width="1560" height="250" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>